<div id="user_nav">
  <% if current_user %>
    Welcome, <%= current_user.name %>!
    <%= link_to "Sign Out", signout_path %>
  <% else %>
    <%= button_to "Sign in with GitHub", "/api/auth/github", form: { data: { turbo: false } } %>
    <%= button_to "Sign in with ORCID", "/api/auth/orcid", form: { data: { turbo: false } } %>
    <%= button_to "Sign in with Google", "/api/auth/google_oauth2", form: { data: { turbo: false } } %>
    <% if Rails.env.development? || Rails.env.test? %>
      <%= button_to "Development Sign-in", "/api/auth/developer", form: { data: { turbo: false } } %>
    <% end %>
  <% end %>
</div>


