{
  "name": "main",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --hmr --host 127.0.0.1",
    "start:production": "ng serve --hmr --configuration production --watch --port 4210",
    "build": "ng build --configuration production",
    "build:watch": "ng build --watch --configuration production",
    "build:generate-stats": "ng build --configuration production --stats-json && webpack-bundle-analyzer ../server/public/stats.json",
    "build:analyze-stats": "yarn run build:generate-stats && webpack-bundle-analyzer ../server/public/stats.json",
    "optimize-icon-svg": "svgo --config .svgo.config.js -f ./src/assets/icons/ -r -o ./src/assets/icons/.tmp",
    "generate-icon-ts": "svg-to-ts-constants",
    "generate-icons": "yarn run optimize-icon-svg && yarn run generate-icon-ts",
    "generate-apollo": "graphql-codegen",
    "generate-apollo:start": "graphql-codegen --watch",
    "generate-icon-data": "scripts/generate-icon-data.js",
    "generate-icon-rst": "scripts/generate-icon-rst.js",
    "generate-docs-rst": "yarn run generate-icon-data && yarn run generate-icon-rst",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "yarn@4.10.3",
  "resolutions": {
    "error-stack-parser": "2.0.6"
  },
  "dependencies": {
    "@angular-devkit/schematics": "21.2.20",
    "@angular/animations": "21.2.19",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/platform-browser-dynamic": "21.2.19",
    "@angular/router": "21.2.19",
    "@apollo/client": "^4.2.11",
    "@ngneat/until-destroy": "^10.0.0",
    "@ngrx/component": "^21.1.1",
    "@ngx-formly/core": "7.1.0",
    "@ngx-formly/ng-zorro-antd": "7.1.0",
    "@typescript-eslint/types": "^8.36.0",
    "@typescript-eslint/utils": "^8.36.0",
    "apollo-angular": "^14.2.0",
    "ng-zorro-antd": "21.3.3",
    "ngx-cookie-service": "^21",
    "ngx-ui-scroll": "4.2.0",
    "rxjs": "^7.8.1",
    "rxjs-etc": "^10.6.2",
    "ts-enum-util": "^4.0.2",
    "ts-mixin-extended": "^1.1.1",
    "vscroll": "patch:vscroll@npm%3A1.8.4#~/.yarn/patches/vscroll-npm-1.8.4-ed08ed8dea.patch",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.20",
    "@angular-eslint/builder": "19.2.0",
    "@angular-eslint/eslint-plugin": "20.1.1",
    "@angular-eslint/eslint-plugin-template": "20.1.1",
    "@angular-eslint/schematics": "19.2.0",
    "@angular-eslint/template-parser": "20.1.1",
    "@angular/build": "21.2.20",
    "@angular/cli": "21.2.20",
    "@angular/compiler-cli": "21.2.19",
    "@ctrl/tinycolor": "^4.1.0",
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/fragment-matcher": "^5.1.0",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-codegen/typescript": "^4.1.5",
    "@graphql-codegen/typescript-apollo-angular": "^5.0.1",
    "@graphql-codegen/typescript-apollo-client-helpers": "^3.0.0",
    "@graphql-codegen/typescript-operations": "^4.5.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@parcel/watcher": "^2.4.1",
    "@types/jsdom": "^30",
    "@types/node": "^20.14.12",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "directory-tree": "^3.5.1",
    "eslint": "8.57.0",
    "graphql": "^16.11.0",
    "jsdom": "^30.0.1",
    "less": "^4.8.1",
    "mustache": "^4.2.0",
    "ngx-json-viewer": "^3.2.1",
    "prettier": "^3.2.4",
    "svg-to-ts": "^12.0.0",
    "svgo": "^3.3.3",
    "ts-node": "~10.9.1",
    "tslib": "^2.3.1",
    "tslint": "~6.1.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "webpack-bundle-analyzer": "^4.5.0"
  }
}
