{
  "name": "main",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --hmr --host 127.0.0.1",
    "start:production": "ng serve --hmr --configuration production --watch --port 4210",
    "build": "ng build --configuration production",
    "build:watch": "ng build --watch --configuration production",
    "build:stats": "ng build --configuration production --stats-json --output-path dist/stats-build",
    "optimize-icon-svg": "svgo --config .svgo.config.js -f ./src/assets/icons/ -r -o ./src/assets/icons/.tmp",
    "generate-icon-ts": "svg-to-ts-constants",
    "generate-icons": "yarn run optimize-icon-svg && yarn run generate-icon-ts",
    "schema:dump": "cd ../server && bundle exec rake graphql:schema:idl",
    "generate-apollo": "graphql-codegen",
    "generate-apollo:start": "graphql-codegen --watch",
    "generate-apollo:full": "yarn run schema:dump && yarn run generate-apollo",
    "generate-icon-data": "scripts/generate-icon-data.js",
    "generate-icon-rst": "scripts/generate-icon-rst.js",
    "generate-docs-rst": "yarn run generate-icon-data && yarn run generate-icon-rst",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "yarn@4.10.3",
  "resolutions": {
    "error-stack-parser": "2.0.6"
  },
  "dependencies": {
    "@angular/animations": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-browser-dynamic": "22.1.1",
    "@angular/router": "22.1.1",
    "@apollo/client": "^4.2.11",
    "@ngneat/until-destroy": "^10.0.0",
    "@ngrx/component": "22.0.0-rc.0",
    "@ngx-formly/core": "7.1.0",
    "@ngx-formly/ng-zorro-antd": "7.1.0",
    "@taiga-ui/polymorpheus": "^5.0.1",
    "@typescript-eslint/types": "^8.36.0",
    "@typescript-eslint/utils": "^8.36.0",
    "apollo-angular": "^14.2.0",
    "date-fns": "^4",
    "ng-zorro-antd": "22.0.1",
    "ngx-cookie-service": "^22",
    "ngx-json-viewer": "^3.2.1",
    "ngx-ui-scroll": "4.2.0",
    "rxjs": "^7.8.1",
    "rxjs-etc": "^10.6.2",
    "ts-enum-util": "^4.0.2",
    "ts-mixin-extended": "^1.1.1",
    "vscroll": "patch:vscroll@npm%3A1.8.4#~/.yarn/patches/vscroll-npm-1.8.4-ed08ed8dea.patch",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.1.3",
    "@angular-devkit/schematics": "22.1.3",
    "@angular-eslint/builder": "19.2.0",
    "@angular-eslint/eslint-plugin": "20.1.1",
    "@angular-eslint/eslint-plugin-template": "20.1.1",
    "@angular-eslint/schematics": "19.2.0",
    "@angular-eslint/template-parser": "20.1.1",
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler": "22.1.1",
    "@angular/compiler-cli": "22.1.1",
    "@ctrl/tinycolor": "^4.1.0",
    "@graphql-codegen/add": "6.0.1",
    "@graphql-codegen/cli": "6.3.1",
    "@graphql-codegen/fragment-matcher": "6.0.1",
    "@graphql-codegen/near-operation-file-preset": "5.1.0",
    "@graphql-codegen/typescript": "5.0.10",
    "@graphql-codegen/typescript-apollo-angular": "5.0.1",
    "@graphql-codegen/typescript-apollo-client-helpers": "4.0.1",
    "@graphql-codegen/typescript-operations": "5.1.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@parcel/watcher": "^2.4.1",
    "@types/jsdom": "^30",
    "@types/node": "^20.14.12",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "directory-tree": "^3.5.1",
    "eslint": "8.57.0",
    "graphql": "^16.11.0",
    "jsdom": "^30.0.1",
    "less": "^4.8.1",
    "mustache": "^4.2.0",
    "prettier": "^3.2.4",
    "svg-to-ts": "^12.0.0",
    "svgo": "^3.3.3",
    "ts-node": "~10.9.1",
    "tslib": "^2.3.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
